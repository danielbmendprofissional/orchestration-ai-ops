{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(node -v*)",
      "Bash(npm -v*)",
      "Bash(git --version*)",
      "Bash(docker --version*)",
      "Bash(code --version*)",
      "Bash(claude --version*)",
      "Bash(ng version*)",
      "Bash(glab --version*)",
      "Bash(glab auth status*)",
      "Bash(docker compose ps*)",
      "Bash(docker info*)",
      "Bash(k3d version*)",
      "Bash(kubectl version --client*)",
      "Bash(helm version*)",
      "Bash(Test-Path *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(winget list *)",
      "Bash(code --list-extensions*)",
      "Bash(where *)",
      "Bash(node infra-config.mjs verify*)",
      "Bash(node infra-config.mjs diff*)",
      "PowerShell(node infra-config.mjs verify*)",
      "PowerShell(node infra-config.mjs diff*)",
      "PowerShell(node -v*)",
      "PowerShell(npm -v*)",
      "PowerShell(git --version*)",
      "PowerShell(docker --version*)",
      "PowerShell(code --version*)",
      "PowerShell(claude --version*)",
      "PowerShell(ng version*)",
      "PowerShell(glab --version*)",
      "PowerShell(glab auth status*)",
      "PowerShell(docker compose ps*)",
      "PowerShell(docker info*)",
      "PowerShell(k3d version*)",
      "PowerShell(kubectl version --client*)",
      "PowerShell(helm version*)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(winget list *)",
      "PowerShell(code --list-extensions*)",
      "PowerShell(where.exe *)",
      "PowerShell(Get-Process \"Docker Desktop\"*)"
    ],
    "deny": [
      "Bash(docker volume rm*)",
      "Bash(docker compose down -v*)",
      "PowerShell(docker volume rm*)",
      "PowerShell(docker compose down -v*)"
    ]
  }
}
